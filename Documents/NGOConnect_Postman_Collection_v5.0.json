    { "key": "BASE_URL", "value": "https://ngoconnectapi-staging.up.railway.app/api/v1", "type": "string" },
    { "key": "ACCESS_TOKEN", "value": "", "type": "string" },
    { "key": "REFRESH_TOKEN", "value": "", "type": "string" },
    { "key": "USER_ID", "value": "1", "type": "string" },
    { "key": "ORG_ID", "value": "1", "type": "string" },
    { "key": "PROJECT_ID", "value": "1", "type": "string" },
    { "key": "POST_ID", "value": "1", "type": "string" },
    { "key": "APPLICATION_ID", "value": "1", "type": "string" },
    { "key": "CAMPAIGN_ID", "value": "1", "type": "string" },
    { "key": "CERT_CODE", "value": "CERT-2026-000001", "type": "string" },
    { "key": "INVITE_ID", "value": "1", "type": "string" },
    { "key": "INVITE_TOKEN", "value": "", "type": "string" },
    { "key": "SHARE_TOKEN", "value": "", "type": "string" }
