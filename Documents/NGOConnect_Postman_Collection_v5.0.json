    {
      "name": "01 - Auth",
      "item": [
        {
          "name": "Send OTP",
          "request": {
            "method": "POST", "auth": { "type": "noauth" },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{BASE_URL}}/auth/send-otp", "host": ["{{BASE_URL}}"], "path": ["auth","send-otp"] },
            "body": { "mode": "raw", "raw": "{\n  \"recipient\": \"9876543210\",\n  \"type\": \"MOBILE\",\n  \"purpose\": \"LOGIN\",\n  \"countryCode\": \"+91\"\n}" }
          }
        },
        {
          "name": "Verify OTP",
          "event": [{ "listen": "test", "script": { "exec": [
            "if (pm.response.code === 200) {",
            "  const r = pm.response.json();",
            "  if (r.data) {",
            "    pm.collectionVariables.set('ACCESS_TOKEN', r.data.accessToken);",
            "    pm.collectionVariables.set('REFRESH_TOKEN', r.data.refreshToken);",
            "  }",
            "}"
          ], "type": "text/javascript" } }],
          "request": {
            "method": "POST", "auth": { "type": "noauth" },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{BASE_URL}}/auth/verify-otp", "host": ["{{BASE_URL}}"], "path": ["auth","verify-otp"] },
            "body": { "mode": "raw", "raw": "{\n  \"recipient\": \"9876543210\",\n  \"type\": \"MOBILE\",\n  \"otpCode\": \"123456\",\n  \"ipAddress\": \"127.0.0.1\"\n}" }
          }
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST", "auth": { "type": "noauth" },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{BASE_URL}}/auth/refresh-token", "host": ["{{BASE_URL}}"], "path": ["auth","refresh-token"] },
            "body": { "mode": "raw", "raw": "{\n  \"refreshToken\": \"{{REFRESH_TOKEN}}\"\n}" }
          }
        },
        {
          "name": "Revoke Token (Logout)",
          "request": {
            "method": "POST",
            "url": { "raw": "{{BASE_URL}}/auth/revoke-token", "host": ["{{BASE_URL}}"], "path": ["auth","revoke-token"] }
          }
        }
      ]
    },

