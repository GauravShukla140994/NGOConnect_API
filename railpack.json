{
  "$schema": "https://schema.railpack.com",
  "provider": "dotnet",
  "packages": {
    "dotnet": "8"
  },
  "steps": {
    "install": {
      "commands": [
        "dotnet restore NGOConnect.API/NGOConnect.API.csproj"
      ]
    },
    "build": {
      "commands": [
        "dotnet publish NGOConnect.API/NGOConnect.API.csproj -c Release -o /app/out --no-restore"
      ]
    }
  },
  "deploy": {
    "startCommand": "dotnet /app/out/NGOConnect.API.dll"
  }
}
