{
  // ── Base configuration — committed to git, NO secrets ──────────────────────
  // Secrets (DB password, JWT key, Cloudinary keys) are NEVER stored here.
  // They are set per-environment:
  //   Development → appsettings.Development.json  (gitignored, local machine)
  //   Staging     → Railway environment variables  (injected at runtime)
  //   Production  → Railway environment variables  (injected at runtime)
  //
  // ASP.NET Core merges files in this order (later overrides earlier):
  //   appsettings.json → appsettings.{Environment}.json → environment variables

  "Jwt": {
    // Key is injected via env var — never stored here
    "Issuer":   "NGOConnect",
    "Audience": "NGOConnectUsers"
  },

  "Cors": {
    // Origins are set per-environment — empty here means env-specific file must provide them
    "AllowedOrigins": []
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft":                  "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System":                     "Warning"
      }
    }
  },

  "AllowedHosts": "*",

  // ── Sentry Error Monitoring ─────────────────────────────────────────────────
  // DSN is project-specific (does NOT change on plan upgrade — only quota increases).
  // For staging/production: override Sentry__Dsn as a Railway environment variable.
  // Leave this as empty string in committed code — never commit a real DSN here.
  "Sentry": {
    "Dsn":              "",
    "TracesSampleRate": 0.2,
    "Debug":            false
  },

  // ── Storage Provider ────────────────────────────────────────────────────────
  // "local"      → LocalFileService  (server disk — used in Development)
  // "cloudinary" → CloudinaryBlobService (CDN — used in Staging + Production)
  // Override this value in the environment-specific appsettings file.
  "StorageProvider": "local",

  // ── Firebase Cloud Messaging ────────────────────────────────────────────────
  // CredentialsJson = full Firebase service-account JSON string.
  // NEVER commit the real value here — leave empty string.
  // Development : paste the JSON into appsettings.Development.json (gitignored)
  //              OR use: dotnet user-secrets set "Firebase:CredentialsJson" "<json>"
  // Railway     : set env var  Firebase__CredentialsJson = <json>
  //              (double underscore maps to colon in ASP.NET Core config)
  // If left empty the API starts normally — push notifications are silently skipped.
  "Firebase": {
    "CredentialsJson": ""
  }
}
