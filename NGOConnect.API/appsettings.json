{
  // ── Base configuration — committed to git, NO secrets ──────────────────────
  // Secrets (DB password, JWT key, Cloudinary keys) are NEVER stored here.
  // They are set per-environment:
  //   Development → appsettings.Development.json  (gitignored, local machine)
  //   Staging     → Railway environment variables  (injected at runtime)
  //   Production  → Railway environment variables  (injected at runtime)
  //
  // ASP.NET Core merges files in this order (later overrides earlier):
  //   appsettings.json → appsettings.{Environment}.json → environment variables

  "Jwt": {
    // Key is injected via env var — never stored here
    "Issuer":   "NGOConnect",
    "Audience": "NGOConnectUsers"
  },

  "Cors": {
    // Origins are set per-environment — empty here means env-specific file must provide them
    "AllowedOrigins": []
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft":                  "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System":                     "Warning"
      }
    }
  },

  "AllowedHosts": "*",

  // ── Storage Provider ────────────────────────────────────────────────────────
  // "local"      → LocalFileService  (server disk — used in Development)
  // "cloudinary" → CloudinaryBlobService (CDN — used in Staging + Production)
  // Override this value in the environment-specific appsettings file.
  "StorageProvider": "local"
}
