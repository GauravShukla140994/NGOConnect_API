{
  // ── Staging environment — Railway deployment ────────────────────────────────
  // This file is committed to git — it contains NO secrets.
  // Secrets are injected by Railway as environment variables:
  //
  //   ConnectionStrings__DefaultConnection  = "Server=...;Pwd=STAGING_PWD;..."
  //   Jwt__Key                              = "staging-secret-key-min-32-chars"
  //   Cloudinary__CloudName                 = "your-cloud-name"
  //   Cloudinary__ApiKey                    = "your-api-key"
  //   Cloudinary__ApiSecret                 = "your-api-secret"
  //   ASPNETCORE_ENVIRONMENT                = "Staging"
  //
  // ASP.NET Core maps __ (double underscore) in env var names to : in config keys.
  // So Jwt__Key in Railway = Jwt:Key in C# code. Zero code changes needed.

  "Cors": {
    "AllowedOrigins": [
      // Replace with your actual Railway staging URL after first deploy
      "https://ngoconnect-api-staging.up.railway.app",
      // Add your React Native / Flutter staging app origin if needed
      "https://staging.ngoconnect.app"
    ]
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System":    "Warning"
      }
    }
  },

  // Cloudinary CDN for staging — credentials injected by Railway env vars
  "StorageProvider": "cloudinary"
}
