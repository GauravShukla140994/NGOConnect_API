{
  // ── TEMPLATE — copy this to appsettings.Development.json and fill in values ─
  // appsettings.Development.json is gitignored — this example file is what gets committed.
  // Never put real credentials in this file.

  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Port=3306;Database=ngoconnect;Uid=root;Pwd=YOUR_DB_PASSWORD;Connection Timeout=30;ConnectionReset=true;ConnectionLifeTime=300;AllowPublicKeyRetrieval=True;CharSet=utf8mb4;SslMode=None;"
  },

  "Jwt": {
    "Key":      "REPLACE_WITH_MIN_32_CHAR_SECRET_KEY_HERE",
    "Issuer":   "NGOConnect",
    "Audience": "NGOConnectUsers"
  },

  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:4200"
    ]
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Information",
        "System":    "Information"
      }
    }
  },

  "AllowedHosts": "*",

  // "local" = LocalFileService (disk)  |  "cloudinary" = CloudinaryBlobService (CDN)
  "StorageProvider": "local",

  "UploadRootPath": "C:\\YourPath\\NGOConnect_API\\UploadFiles",
  "UploadBaseUrl":  "http://localhost:5000/uploads",

  "Cloudinary": {
    "CloudName": "YOUR_CLOUDINARY_CLOUD_NAME",
    "ApiKey":    "YOUR_CLOUDINARY_API_KEY",
    "ApiSecret": "YOUR_CLOUDINARY_API_SECRET"
  }
}
